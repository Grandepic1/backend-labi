APP_NAME=backend-labi
# development | production.
# production disables /docs + /redoc, forces debug off (no tracebacks,
# no SQL echo, WARNING-level logs, no auto-reload).
APP_ENV=development
DEBUG=True

# Comma-separated list of allowed frontend domains (CORS)
FRONTEND_URLS=http://localhost:3000,https://app.example.com

# Auth (JWT) — generate a real secret for production
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=labi

# Optional full override, e.g.:
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/labi
