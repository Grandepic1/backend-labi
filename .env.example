APP_NAME=backend-labi
# development | production.
# production disables /docs + /redoc, forces debug off (no tracebacks,
# no SQL echo, WARNING-level logs, no auto-reload).
APP_ENV=development
DEBUG=True

# Comma-separated list of allowed frontend domains (CORS)
FRONTEND_URLS=http://localhost:3000,https://app.example.com

# Auth (JWT) — generate a real secret for production
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=labi

# Labi MVP storage (local private dir)
STORAGE_DIR=./storage
# Max audio upload bytes (25 MB)
MAX_UPLOAD_BYTES=26214400
# Comma-separated allow-list for audio uploads
ALLOWED_AUDIO_MIME=audio/webm,audio/mp4,audio/mpeg,audio/wav,audio/x-wav,audio/ogg

# --- Labi analysis: speech metrics (ffmpeg/ffprobe must be on PATH) ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Hard cap around one media subprocess (seconds)
FFMPEG_TIMEOUT_SECONDS=120
# silencedetect noise floor (dB)
PAUSE_NOISE_DB=-30.0
# Technical detection floor only; every detected pause is stored raw
PAUSE_MIN_MS=100
# Comma-separated filler tokens removed before counting words
FILLED_PAUSE_TOKENS=eee,ee,eeh,ehm,em,hmm,hm,mmm,mm,eh,ah,oh,uh,uhm

# --- Labi analysis: local LLM (LM Studio OpenAI-compatible server) ---
AI_BASE_URL=http://127.0.0.1:1234/v1
# LM Studio ignores this value but requires a bearer header
AI_API_KEY=lm-studio
# Model id from GET {AI_BASE_URL}/models; empty ⇒ IU suggestions fail AI_NOT_CONFIGURED
AI_MODEL=
# httpx timeout for one completion (seconds) — local models are slow
AI_TIMEOUT_SECONDS=600

# --- Labi analysis: local ASR (faster-whisper, in-process) ---
# Model name or local directory; weights are fetched by scripts/fetch_asr_model.py
ASR_MODEL=large-v3
# auto | cpu | cuda — cpu is the safe default (see app/core/config.py)
ASR_DEVICE=cpu
# int8 on CPU, float16 with cuda
ASR_COMPUTE_TYPE=int8
ASR_MODEL_DIR=./models
# "" = auto-detect
ASR_LANGUAGE=id
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=True
# Hard cap around one transcription (seconds)
ASR_TIMEOUT_SECONDS=1800

# Optional full override, e.g.:
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/labi
